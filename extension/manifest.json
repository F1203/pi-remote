{
  "manifest_version": 3,
  "name": "Pi Remote - teclado",
  "version": "1.7",
  "description": "Avisa al control remoto cuando se enfoca un campo de texto, adelanta el video de la pestaña activa, permite navegar YouTube con la cruceta (modo tele) y maneja los modos anime y YouTube.",
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tv.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://player.zilla-networks.com/*"
      ],
      "js": [
        "zilla.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "scripting",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "anime",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
